{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CityInspection CI-E1 dynamic sensor acceptance experiment",
  "type": "object",
  "required": [
    "schema_version", "experiment_id", "experiment_type", "random_seed",
    "simulation", "region", "task", "actors", "sensors", "dynamic",
    "acceptance", "output"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "experiment_id": {"type": "string", "pattern": "^CI_E1_"},
    "experiment_type": {"const": "dynamic_sensor_acceptance"},
    "random_seed": {"type": "integer"},
    "simulation": {
      "type": "object",
      "required": ["package_root", "map", "carla_port", "airsim_port", "traffic_manager_port", "synchronous_mode", "fixed_delta_seconds", "duration_seconds"]
    },
    "region": {
      "type": "object",
      "required": ["region_id", "selection_status", "boundary", "ugv_spawn_point_id", "target_transform", "planned_ugv_route", "uav"]
    },
    "sensors": {
      "type": "object",
      "required": ["frequency_hz", "width", "height", "streams"]
    },
    "dynamic": {
      "type": "object",
      "required": ["mode", "ugv_target_speed_mps", "uav_speed_mps", "target_static", "save_all_samples"]
    },
    "acceptance": {"type": "object"},
    "output": {"type": "object", "required": ["root"]}
  },
  "additionalProperties": true
}

