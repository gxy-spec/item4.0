{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic_target_message_schema.json",
  "title": "S1 perception target-level semantic message",
  "type": "object",
  "required": [
    "message_id",
    "source",
    "destination",
    "message_type",
    "oracle",
    "target_category",
    "target_subcategory_hypothesis",
    "target_color",
    "target_world_position_xyz",
    "position_uncertainty_m",
    "detection_confidence",
    "color_confidence",
    "red_pixel_ratio",
    "van_like_score",
    "instruction_match_score",
    "track_id",
    "source_frame",
    "source_timestamp",
    "source_kind",
    "evidence",
    "sent_frame",
    "sent_timestamp",
    "received_frame",
    "received_timestamp",
    "latency_ms",
    "status",
    "payload_bytes"
  ],
  "properties": {
    "message_id": {"type": "string"},
    "source": {"const": "uav"},
    "destination": {"const": "ugv"},
    "message_type": {"const": "target_candidate_v1"},
    "oracle": {"const": false},
    "target_category": {"const": "vehicle"},
    "target_subcategory_hypothesis": {"type": "string"},
    "target_color": {"const": "red"},
    "target_world_position_xyz": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 3,
      "maxItems": 3
    },
    "position_uncertainty_m": {"type": "number", "minimum": 0},
    "detection_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "color_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "red_pixel_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "van_like_score": {"type": "number", "minimum": 0, "maximum": 1},
    "instruction_match_score": {"type": "number", "minimum": 0, "maximum": 1},
    "track_id": {"type": "string"},
    "source_frame": {"type": "integer", "minimum": 0},
    "source_timestamp": {"type": "number", "minimum": 0},
    "source_kind": {"const": "uav_rgb_depth_perception"},
    "evidence": {
      "type": "object",
      "required": ["rgb_frame", "depth_frame", "proposal_source", "temporal_hits"]
    },
    "sent_frame": {"type": "integer", "minimum": 0},
    "sent_timestamp": {"type": "number", "minimum": 0},
    "received_frame": {"type": ["integer", "null"]},
    "received_timestamp": {"type": ["number", "null"]},
    "latency_ms": {"type": ["number", "null"], "minimum": 0},
    "status": {"enum": ["sent", "delivered"]},
    "payload_bytes": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": true
}
